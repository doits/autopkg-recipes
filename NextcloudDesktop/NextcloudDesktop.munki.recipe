<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>Description</key>
		<string>Downloads the latest release of Nextcloud Desktop and imports it into Munki.</string>
		<key>Identifier</key>
		<string>com.github.doits.munki.NextcloudDesktop</string>
		<key>Input</key>
		<dict>
			<key>MUNKI_REPO_SUBDIR</key>
			<string>apps/%NAME%</string>
			<key>NAME</key>
			<string>NextcloudDesktop</string>
			<key>MUNKI_CATEGORY</key>
			<string>Utilities</string>
			<key>pkginfo</key>
			<dict>
				<key>catalogs</key>
				<array>
					<string>testing</string>
					<string>production</string>
				</array>
				<key>developer</key>
				<string>Nextcloud GmbH</string>
				<key>display_name</key>
				<string>Nextcloud Desktop</string>
				<key>name</key>
				<string>%NAME%</string>
				<key>category</key>
				<string>%MUNKI_CATEGORY%</string>
				<key>unattended_install</key>
				<true/>
        <key>postinstall_script</key>
        <string>#!/bin/sh

        CURRENT_USER=$(stat -f '%Su' /dev/console)

        if [ -z "$CURRENT_USER" ] || [ "$CURRENT_USER" = "root" ] || [ "$CURRENT_USER" = "loginwindow" ]; then
            echo "No GUI user currently logged in. Nextcloud will launch normally on their next login."
            exit 0
        fi

        USER_UID=$(id -u "$CURRENT_USER")

        echo "Launching Nextcloud Client for user: $CURRENT_USER (UID: $USER_UID)..."

        launchctl asuser "$USER_UID" open -a "/Applications/Nextcloud.app"

        exit 0
        </string>
			</dict>
		</dict>
		<key>MinimumVersion</key>
		<string>0.6.1</string>
		<key>ParentRecipe</key>
		<string>com.github.doits.download.NextcloudDesktop</string>
		<key>Process</key>
		<array>
			<dict>
				<key>Arguments</key>
				<dict>
					<key>repo_subdirectory</key>
					<string>%MUNKI_REPO_SUBDIR%</string>
					<key>pkg_path</key>
					<string>%pathname%</string>
				</dict>
				<key>Processor</key>
				<string>MunkiImporter</string>
			</dict>
		</array>
	</dict>
</plist>
